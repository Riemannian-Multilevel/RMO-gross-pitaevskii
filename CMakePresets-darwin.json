{
  "version": 6,
  "configurePresets": [
    {
      "name": "mac-base",
            "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": ":ON",
        "deal.II_DIR": "/Applications/deal.II.app/Contents/Resources/Libraries/lib/cmake/deal.II",
        "Boost_DIR": "/Applications/deal.II.app/Contents/Resources/Libraries/lib/cmake/Boost-1.83.0"
      }
    },
    {
      "name": "mac-debug",
      "inherits": "mac-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "mac-release",
      "inherits": "mac-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "mac-debug", "configurePreset": "mac-debug" },
    { "name": "mac-release", "configurePreset": "mac-release" }
  ],
  "testPresets": [
    { "name": "mac-debug", "configurePreset": "mac-debug",
      "output": { "outputOnFailure": true } },
    { "name": "mac-release", "configurePreset": "mac-release",
      "output": { "outputOnFailure": true } }
  ]
}
